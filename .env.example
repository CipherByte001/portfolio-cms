# ─── Payload CMS Environment Variables ───────────────────────────────────────

# MongoDB connection string from MongoDB Atlas
# Format: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/portfolio-cms
MONGODB_URI=mongodb+srv://your-user:your-password@cluster0.xxxxx.mongodb.net/portfolio-cms

# Secret key for signing JWT tokens — make this long and random (32+ chars)
PAYLOAD_SECRET=replace-this-with-a-long-random-secret-string

# Port the CMS server runs on (Railway sets this automatically)
PORT=3001

# The public URL of your deployed CMS (used for media URLs in production)
# On Railway this will be something like: https://portfolio-cms.up.railway.app
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001

# CORS: your portfolio's deployed URL on Vercel (and localhost for dev)
CORS_ORIGIN=http://localhost:5173,https://your-portfolio.vercel.app
