{
  "name": "portfolio-cms",
  "version": "1.0.0",
  "description": "Payload CMS backend for Eitmam Omar Sanam's portfolio",
  "license": "MIT",
  "engines": {
    "node": ">=18.20.2"
  },
  "scripts": {
    "dev": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload build && tsc",
    "start": "cross-env PAYLOAD_CONFIG_PATH=dist/payload.config.js NODE_ENV=production node dist/server.js",
    "generate:types": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload generate:types"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "payload": "1.15.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.3.78": true,
    "es5-ext@0.10.64": true,
    "sharp@0.31.3": true
  }
}
